# Local secrets for the live-server smoke tests in
# `app/src/test/java/moe/antimony/hoshi/features/sync/http/HttpSyncLiveServerSmokeTest.kt`.
#
# Copy this file to `.hoshi-sync-secret.env` (gitignored) and fill in the values.
# The test will pick them up automatically when env vars are not already set.
#
# Run with:
#   source .hoshi-sync-secret.env && ./gradlew :app:testDebugUnitTest \
#       --tests 'moe.antimony.hoshi.features.sync.http.HttpSyncLiveServerSmokeTest'
#
# Without these values the live tests are SKIPPED (via JUnit `Assume`); the rest of the
# suite uses an in-memory fake transport and never needs them.

HOSHI_KV_BASE_URL=https://dragos.games/api/book_sync
HOSHI_KV_TOKEN=paste-your-token-here

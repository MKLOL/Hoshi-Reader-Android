<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome (themed-icon, Android 13+) deliberately omitted: the foreground is a
     multi-colour bitmap whose alpha-channel silhouette wouldn't tint cleanly. Users on
     'Themed icons' will get the full-colour version like everyone else, which is the
     correct trade-off until/unless someone draws a dedicated monochrome silhouette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
